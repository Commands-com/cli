{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "scripts/maintainability-check.mjs",
    "bin/**/*.js",
    "src/**/*.js",
    "test/**/*.js"
  ],
  "exclude": [
    "node_modules",
    ".commands-com"
  ],
  "maintainabilityGuard": {
    "status": "enforced-incremental",
    "reason": "Runtime files are capped with limited headroom above the current largest runtime file. Oversized tests and unused runtime exports fail the guard; JS checking covers bin, src, and test files recursively.",
    "runtimeRoots": [
      "bin",
      "src"
    ],
    "excludedRoots": [],
    "maxRuntimeFileLines": 418,
    "testFileReportRoots": [
      "test"
    ],
    "testFileReportLimit": 5,
    "maxTestFileLines": 700,
    "testFileSizePolicy": "fail",
    "unusedExportPolicy": "fail",
    "unusedExportRoots": [
      "bin",
      "src"
    ],
    "unusedExportConsumerRoots": [
      "bin",
      "src",
      "test"
    ],
    "unusedExportReportLimit": 20,
    "typeCheckRoots": [
      "bin",
      "src"
    ]
  }
}
