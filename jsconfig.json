{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "scripts/maintainability-check.mjs",
    "src/args.js",
    "src/artifact-paths.js",
    "src/assessment-completion.js",
    "src/assessment-cycle.js",
    "src/assessment-final-report.js",
    "src/assessment-prompts.js",
    "src/assessment-report.js",
    "src/cli.js",
    "src/codex-jsonl.js",
    "src/command-option-resolver.js",
    "src/command-option-schema.js",
    "src/command-options.js",
    "src/command-registry.js",
    "src/command-result.js",
    "src/config.js",
    "src/cycle-fanout.js",
    "src/cycle-implementation.js",
    "src/cycle-preflight.js",
    "src/cycle-progress.js",
    "src/cycle-report.js",
    "src/cycle-state.js",
    "src/cycle-summary.js",
    "src/cycle-synthesis.js",
    "src/cycle-workflow.js",
    "src/doctor.js",
    "src/errors.js",
    "src/fanout.js",
    "src/git.js",
    "src/implementation.js",
    "src/implementation-prompts.js",
    "src/implementation-task-artifacts.js",
    "src/implementation-task-attempt.js",
    "src/implementation-task-context.js",
    "src/implementation-task-merge.js",
    "src/implementation-task-patch.js",
    "src/init.js",
    "src/logger.js",
    "src/mock-provider.js",
    "src/number-utils.js",
    "src/objects.js",
    "src/output-string.js",
    "src/process-runner.js",
    "src/prompt-intent.js",
    "src/provider-adapters.js",
    "src/provider-fallback.js",
    "src/provider-invocation.js",
    "src/provider-item-workflow.js",
    "src/provider-os-shell.js",
    "src/provider-limits.js",
    "src/provider-output.js",
    "src/provider-registry.js",
    "src/provider-retry.js",
    "src/provider-selection.js",
    "src/providers.js",
    "src/quality.js",
    "src/repo-context-prompt.js",
    "src/review.js",
    "src/room-report.js",
    "src/rooms.js",
    "src/rooms/catalog.js",
    "src/run-id.js",
    "src/run-state.js",
    "src/run-store.js",
    "src/runs.js",
    "src/safe-path.js",
    "src/summary-contract.js",
    "src/summary.js",
    "src/task-plan-parsing.js",
    "src/task-worktrees.js",
    "src/workflow-constants.js",
    "src/workflow.js",
    "test/codex-jsonl.test.js",
    "test/cycle-progress.test.js",
    "test/dependency-cycles.test.js",
    "test/e2e-quality-until.test.js",
    "test/fanout.test.js",
    "test/maintainability-check.test.js",
    "test/objects.test.js",
    "test/prompt-intent.test.js",
    "test/provider-fallback.test.js",
    "test/provider-invocation.test.js",
    "test/provider-registry.test.js",
    "test/provider-resolution.test.js",
    "test/provider-retry.test.js",
    "test/safe-path.test.js",
    "test/workflow-constants.test.js"
  ],
  "exclude": [
    "node_modules",
    ".commands-com"
  ],
  "maintainabilityGuard": {
    "status": "enforced-incremental",
    "reason": "Runtime files are capped with limited headroom above the current largest runtime file. Oversized tests and unused runtime exports fail the guard; JS checking remains incremental and expands only to files that pass without production edits.",
    "runtimeRoots": [
      "bin",
      "src"
    ],
    "excludedRoots": [],
    "maxRuntimeFileLines": 418,
    "testFileReportRoots": [
      "test"
    ],
    "testFileReportLimit": 5,
    "maxTestFileLines": 700,
    "testFileSizePolicy": "fail",
    "unusedExportPolicy": "fail",
    "unusedExportRoots": [
      "bin",
      "src"
    ],
    "unusedExportConsumerRoots": [
      "bin",
      "src",
      "test"
    ],
    "unusedExportAllowlist": [],
    "unusedExportReportLimit": 20,
    "typeCheckRoots": [
      "src"
    ],
    "typeCheckAllowlist": []
  }
}
